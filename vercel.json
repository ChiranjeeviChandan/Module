{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/dejavu-fonts-ttf/ttf/**,node_modules/mupdf/dist/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }]
}
